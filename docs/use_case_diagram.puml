@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "Коммерческий директор" as Director
actor "Менеджер по продажам" as Manager
actor "Аналитик" as Analyst
actor "Администратор системы" as Admin

rectangle "Business Metrics Analyzer" {
  usecase "Просмотр дашборда KPI" as Dashboard
  usecase "Мобильная версия" as Mobile
  usecase "Уведомления о KPI" as Notifications
  usecase "Загрузка данных\nо продажах" as Upload
  usecase "Формирование отчёта" as Report
  usecase "Экспорт отчёта\nв Excel" as Export
  usecase "Автоматический\nрасчёт KPI" as Calculate
  usecase "Управление пользователями\nи ролями" as Users
  usecase "Настройка метрик" as Metrics
}

Director --> Dashboard
Director --> Mobile
Director --> Notifications

Manager --> Upload

Analyst --> Report

Admin --> Users
Admin --> Metrics

Export ..> Report : <<extend>>
Report ..> Calculate : <<include>>
@enduml
